{
  "id": "com.psgassist.plugin",
  "name": "PSG Assist",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "psgAssistPanel",
      "label": {
        "default": "PSG Assist"
      },
      "minimumSize": { "width": 280, "height": 320 },
      "maximumSize": { "width": 600, "height": 1400 },
      "preferredDockedSize": { "width": 320, "height": 480 },
      "preferredFloatingSize": { "width": 320, "height": 480 }
    }
  ],
  "manifestVersion": 5
}
